        ┌──────────────┐
        │   products   │
        ├──────────────┤
        │ id (PK)      │
        │ name         │
        │ price        │
        │ category     │
        │ instock      │
        └──────┬───────┘
               │
               │
     ┌─────────▼─────────┐
     │   cart_items      │
     ├───────────────────┤
     │ id (PK)           │
     │ user_id           │
     │ product_id (FK)   │
     │ quantity          │
     └─────────┬─────────┘
               │
               │ checkout
               ▼
        ┌──────────────┐
        │    orders    │
        ├──────────────┤
        │ id (PK)      │
        │ user_id      │
        │ total_amount │
        │ status       │
        └──────┬───────┘
               │
               │
     ┌─────────▼─────────┐
     │  order_items      │
     ├───────────────────┤
     │ id (PK)           │
     │ order_id (FK)     │
     │ product_id (FK)   │
     │ quantity          │
     │ price             │
     └───────────────────┘

